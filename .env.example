DATABASE_URL=postgresql+psycopg://conceptualize:conceptualize@localhost:54329/conceptualize
# Development-only local services above. Use unique credentials and restricted networking in production.
POSTGRES_PASSWORD=conceptualize
POSTGRES_HOST_PORT=54329
REDIS_URL=redis://127.0.0.1:63799/0
REDIS_HOST_PORT=63799
APP_ENV=development
LOG_LEVEL=INFO
# Optional collector. OTel spans always have trace IDs; HTTP export is opt-in.
OTEL_EXPORTER_OTLP_ENDPOINT=
CONCEPTUALIZE_API_URL=http://127.0.0.1:8000
# Copy the one-time key printed by the explicit `conceptualize seed` command here.
CONCEPTUALIZE_API_KEY=
# Set the Next.js process environment to these same API settings.
