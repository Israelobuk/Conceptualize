      "name": "conceptualize_map",
      "description": "Orient in an unfamiliar or large repository when the relevant subsystem is unknown. For conversation sources this returns conversation titles/counts only; call pack or search once for bounded relevant history. Do not expand every message. Scope repository maps to a directory; for a known target use inspect instead.",
      "inputSchema": {
        "properties": {
          "path": {
            "default": "",
            "title": "Path",
            "type": "string"
          },
          "token_budget": {
            "default": 2000,
            "title": "Token Budget",
            "type": "integer"
          },
          "source_types": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Source Types"
          },
          "force_refresh": {
