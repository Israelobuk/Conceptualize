            "title": "Force Refresh",
            "type": "boolean"
          }
        },
        "required": [
          "query"
        ],
        "title": "conceptualize_searchArguments",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      }
    },
    {
      "name": "conceptualize_dependencies",
